# Copy this file to `.env` and fill in real values.
# `.env` is gitignored. This file (.env.example) is safe to commit because it
# has no real keys in it — it documents WHICH keys the project needs.

# Reasoning: understanding what the user meant, and phrasing replies.
# Free tier, no card required. Get one at:
# https://aistudio.google.com/apikey
GOOGLE_API_KEY=

# Indic speech-to-text and text-to-speech. Not needed until the voice phase.
# https://dashboard.sarvam.ai
SARVAM_API_KEY=

# Optional. The LLM sits behind a protocol (see app/flow/intents.py), so a
# second provider can be dropped in without touching the state machine.
# https://platform.claude.com/settings/keys
# ANTHROPIC_API_KEY=
